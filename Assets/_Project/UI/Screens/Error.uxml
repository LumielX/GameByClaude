<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:VisualElement name="error" class="overlay">
    <ui:VisualElement class="card col" style="width: 620px; border-color: rgb(255, 194, 75);">
      <ui:Label text="@error.title" class="h2 heavy warn" />
      <ui:Label name="message" text="" class="wrap" style="font-size: 20px; margin-bottom: 20px;" />
      <ui:VisualElement class="row">
        <ui:Button name="download" text="@error.download" class="btn btn-primary heavy" style="margin-right: 12px;" />
        <ui:Button name="close" text="@error.close" class="btn" />
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
